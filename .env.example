# Variables de entorno de AuraNova API.
#  - Local: copia este archivo como .env en la raíz del repo (el .env NO se sube a git).
#  - Render: las mismas claves van en Environment.
# Las líneas vacías o sin valor se ignoran.

ASPNETCORE_ENVIRONMENT=Development

# Base de datos: host, puerto, base y usuario están en src/AuraNova.API/appsettings.json.
# Solo hace falta la contraseña:
Database__Password=

# Opcional: cadena completa para apuntar a otra BD (si existe, tiene prioridad sobre Database__*)
# ConnectionStrings__DefaultConnection=

# Opcional: no aplicar migraciones al arrancar (p. ej. al usar una instancia local contra producción)
# Database__ApplyMigrationsOnStartup=false

# JWT (en local también puede venir de dotnet user-secrets)
JwtSettings__SecretKey=
JwtSettings__Issuer=AuraNova.API
JwtSettings__Audience=AuraNova.Admin

# Supabase Storage
Supabase__Url=https://jfxbsnhzbkdawncdatwb.supabase.co
Supabase__ServiceRoleKey=
# Supabase__PrivateBucket=customer-files

# CORS
Security__AllowedOrigins__0=http://localhost:3000

# Opcional: cancelar pedidos de catálogo impagos tras N horas (0 = desactivado)
# Orders__UnpaidExpirationHours=0

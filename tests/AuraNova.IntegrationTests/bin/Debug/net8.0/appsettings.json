{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=auranova;Username=postgres;Password=YOUR_PASSWORD"
  },
  "JwtSettings": {
    "Issuer": "AuraNova.API",
    "Audience": "AuraNova.Admin",
